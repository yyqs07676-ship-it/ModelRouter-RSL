# Local standalone mode
ROUTER_RUNTIME_MODE=standalone
ROUTER_ENABLE_STANDALONE_KEYS=true
ROUTER_ENABLE_ADMIN_API=true
ROUTER_ENABLE_USAGE_API=true

ROUTER_INTERNAL_API_KEY=dev-router-key
ADMIN_API_KEY=dev-admin-key
ROUTER_DB=router.db

# Do not auto-sync: the local Ollama model list is registered explicitly in config/providers.yaml
AUTO_SYNC_PROVIDER_MODELS=false

# Local Ollama exposed through its OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_HEALTH_URL=http://127.0.0.1:11434/api/tags
OLLAMA_KEY=ollama

ROUTER_PROVIDER_TIMEOUT=180
